<Window x:Class="EliteWhisper.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EliteWhisper.Models"
        xmlns:controls="clr-namespace:EliteWhisper.Controls"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Widget Button Style - Light theme -->
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootContainer">
<!-- SHADOW LAYER: Pill-shaped, slightly larger, positioned behind -->
        <Border x:Name="ShadowLayer"
                Height="40"
                MinWidth="104"
                CornerRadius="20"
                Background="{StaticResource ShadowBrush}"
                Opacity="0.12"
                Margin="0,4,0,0"
                IsHitTestVisible="False"
                Panel.ZIndex="0"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"/>
        
        <!-- CONTENT LAYER: Main visible surface -->
        <Border x:Name="ContentLayer"
                Height="36"
                MinWidth="96"
                Padding="14,0"
                CornerRadius="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                Panel.ZIndex="1"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            
            <Grid>
                <!-- ==================== PILL MODE (Collapsed + HoverExpanded) ==================== -->
                <StackPanel x:Name="PillContent"
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <!-- State Indicator -->
                    <Grid Width="20" Height="20" Margin="0,0,8,0">
                        
                        <!-- Pulse Ring (Listening only) -->
                        <Ellipse x:Name="PulseRing" 
                                 Width="20" Height="20" 
                                 Fill="{StaticResource PrimaryBrush}" 
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:WidgetState.Listening}">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseStoryboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                       From="1" To="1.6" Duration="0:0:1" AutoReverse="True"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                       From="1" To="1.6" Duration="0:0:1" AutoReverse="True"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                       From="0.35" To="0" Duration="0:0:1" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        
                        <!-- Core Dot: 8px circle with breathing animation for Processing -->
                        <Ellipse x:Name="CoreDot" Width="8" Height="8" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:WidgetState.Listening}">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:WidgetState.Processing}">
                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="BreathingStoryboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                       From="1" To="1.05" Duration="0:0:0.75" AutoReverse="True"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                       From="1" To="1.05" Duration="0:0:0.75" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="BreathingStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    
                    <!-- Status Text -->
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                     
                    <!-- Mini Waveform (5 bars, visible only when listening) -->
                    <controls:WaveformControl 
                        Amplitudes="{Binding MiniAmplitudes}"
                        BarCount="5"
                        BarWidth="1.5"
                        BarSpacing="2"
                        MaxBarHeight="7"
                        MinBarHeight="1"
                        CenterGap="1.5"
                        BarFill="{StaticResource PrimaryBrush}"
                        Width="28"
                        Height="20"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}"/>
                    
                    <!-- Hover Action Buttons (visible only in HoverExpanded) -->
                    <StackPanel x:Name="HoverButtons"
                                Orientation="Horizontal" 
                                Margin="8,0,0,0"
                                Visibility="{Binding IsHoverExpanded, Converter={StaticResource BoolToVis}}">
                        
                        <!-- Change Mode Button (Stub) -->
                        <Button Style="{StaticResource WidgetIconButton}" 
                                ToolTip="Change mode (Ctrl+Shift+M)" 
                                Margin="0,0,2,0"
                                Width="28" Height="28">
                            <Path Data="{StaticResource IconGearGeometry}" 
                                  Fill="{StaticResource TextPrimaryBrush}" 
                                  Stretch="Uniform" 
                                  Width="12" Height="12"/>
                        </Button>
                        
                        <!-- Record/Stop Button (mirrors hotkey) -->
                        <Button Style="{StaticResource WidgetIconButton}" 
                                ToolTip="{Binding RecordButtonTooltip}"
                                Command="{Binding ToggleRecordingCommand}"
                                Margin="0,0,2,0"
                                Width="28" Height="28">
                            <Grid>
                                <!-- Mic icon when not listening -->
                                <Path Data="{StaticResource IconMicrophoneGeometry}" 
                                      Fill="{StaticResource TextPrimaryBrush}" 
                                      Stretch="Uniform" 
                                      Width="12" Height="12">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!-- Stop icon when listening -->
                                <Rectangle Width="8" Height="8" 
                                           Fill="{StaticResource ErrorBrush}" 
                                           RadiusX="2" RadiusY="2"
                                           Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                        
                        <!-- Expand Button -->
                        <Button Style="{StaticResource WidgetIconButton}" 
                                ToolTip="Expand window"
                                Command="{Binding ExpandCommand}"
                                Width="28" Height="28">
                            <Path Data="M 4 14 L 14 14 L 14 4 M 14 14 L 4 4" 
                                  Stroke="{StaticResource TextPrimaryBrush}" 
                                  StrokeThickness="2"
                                  Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                
                <!-- ==================== EXPANDED MODE (Compact Horizontal Pill) ==================== -->
                <Grid x:Name="ExpandedContent"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                      Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- State dot -->
                        <ColumnDefinition Width="Auto"/>  <!-- Status text -->
                        <ColumnDefinition Width="*"/>     <!-- Waveform (flex) -->
                        <ColumnDefinition Width="Auto"/>  <!-- Mode badge -->
                        <ColumnDefinition Width="Auto"/>  <!-- Record/Stop -->
                        <ColumnDefinition Width="Auto"/>  <!-- Collapse -->
                    </Grid.ColumnDefinitions>
                    
<!-- State Indicator Dot -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                           Fill="{StaticResource TextTertiaryBrush}"/>
                    
                    <!-- Status Text -->
                    <TextBlock Grid.Column="1" 
                               Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0"/>
                    
                    <!-- Waveform Visualization (7 vertical bars, centered) -->
                    <Border Grid.Column="2" 
                            Background="{StaticResource HoverSurfaceBrush}" 
                            CornerRadius="10" 
                            Height="36"
                            Margin="0,0,10,0"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <controls:WaveformControl 
                            Amplitudes="{Binding ExpandedAmplitudes}"
                            BarCount="7"
                            BarWidth="2"
                            BarSpacing="3"
                            MaxBarHeight="16"
                            MinBarHeight="2"
                            CenterGap="3"
                            BarFill="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="70"
                            Height="28"/>
                    </Border>
                    
                    <!-- Mode Badge (shows current mode/provider) -->
                    <Border Grid.Column="3"
                            Background="{StaticResource HoverSurfaceBrush}"
                            CornerRadius="8"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasActiveMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ActiveModeDisplay}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="10" 
                                   FontWeight="Medium"
                                   FontFamily="{StaticResource FontPrimary}"/>
                    </Border>
                    
                    <!-- Record/Stop Button -->
                    <Button Grid.Column="4" 
                            Style="{StaticResource WidgetIconButton}" 
                            ToolTip="{Binding RecordButtonTooltip}"
                            Command="{Binding ToggleRecordingCommand}"
                            Width="32" Height="32"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- Mic icon when not listening -->
                            <Path Data="{StaticResource IconMicrophoneGeometry}" 
                                  Fill="{StaticResource TextPrimaryBrush}" 
                                  Stretch="Uniform" 
                                  Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!-- Stop icon when listening -->
                            <Rectangle Width="10" Height="10" 
                                       Fill="{StaticResource ErrorBrush}" 
                                       RadiusX="2" RadiusY="2"
                                       Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    
                    <!-- Collapse/Close Button -->
                    <Button Grid.Column="5" 
                            Style="{StaticResource WidgetIconButton}" 
                            ToolTip="Collapse (Esc)"
                            Command="{Binding CollapseCommand}"
                            Width="32" Height="32"
                            VerticalAlignment="Center">
                        <Path Data="M 4 4 L 12 12 M 12 4 L 4 12" 
                              Stroke="{StaticResource TextPrimaryBrush}" 
                              StrokeThickness="2"
                              Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>